  <rule e="way" k="building" v="school|university|college|kindergarten" zoom-min="15"><area fill="#BCD2F2" stroke="#6C93D2" stroke-width="0.8" /></rule>
  <rule e="way" k="building" v="apartments|residential|dormitory" zoom-min="15"><area fill="#CFC5BE" stroke="#A89A8E" stroke-width="0.5" /></rule>
