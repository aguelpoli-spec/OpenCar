    version="5" map-background="#F2EFE9" map-background-outside="#DDDDDD">

  <!-- agua y verde -->
  <rule e="way" k="natural" v="water|riverbank|bay"><area fill="#AAD3DF" /></rule>
  <rule e="way" k="waterway" v="riverbank|dock"><area fill="#AAD3DF" /></rule>
  <rule e="way" k="landuse" v="forest|wood|grass|meadow|recreation_ground|village_green|cemetery"><area fill="#CDEBB0" /></rule>
  <rule e="way" k="natural" v="wood|scrub|grassland"><area fill="#CDEBB0" /></rule>
  <rule e="way" k="leisure" v="park|garden|playground|pitch|stadium|golf_course"><area fill="#C8FACC" /></rule>
  <rule e="way" k="landuse" v="residential"><area fill="#EDE7E1" /></rule>
  <rule e="way" k="landuse" v="commercial|retail"><area fill="#F2DAD9" /></rule>
  <rule e="way" k="landuse" v="industrial"><area fill="#EBDBE8" /></rule>
  <rule e="way" k="amenity" v="school|university|college|hospital|parking"><area fill="#F0F0D8" /></rule>
