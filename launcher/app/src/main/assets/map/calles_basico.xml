    <line stroke="#B8523A" stroke-width="5.4" stroke-linecap="round" />
    <line stroke="#F9A98C" stroke-width="4.0" stroke-linecap="round" />
  </rule>
  <rule e="way" k="highway" v="primary|primary_link">
    <line stroke="#B58A3A" stroke-width="5.0" stroke-linecap="round" />
    <line stroke="#FCD68A" stroke-width="3.6" stroke-linecap="round" />
  </rule>
  <rule e="way" k="highway" v="secondary|secondary_link">
    <line stroke="#A9A24A" stroke-width="4.6" stroke-linecap="round" />
    <line stroke="#F7FABF" stroke-width="4.0" stroke-linecap="round" />
  </rule>
  <rule e="way" k="highway" v="tertiary|tertiary_link|unclassified|residential|living_street|road">
